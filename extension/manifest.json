{
  "manifest_version": 3,
  "name": "Chrome Tabs Bridge",
  "version": "0.1.0",
  "description": "Bridge Chrome tab group APIs to the Chrome Tabs Alfred workflow.",
  "key": "",
  "minimum_chrome_version": "89",
  "permissions": [
    "nativeMessaging",
    "tabGroups",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Chrome Tabs Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
